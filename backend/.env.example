# Copy this file to backend/.env and fill in real values.
#   cp backend/.env.example backend/.env

# ─── Required ───────────────────────────────────────────────────────────────
# MongoDB connection string. Prisma needs a replica set, so use MongoDB Atlas
# (the free M0 tier works) rather than a plain standalone mongod.
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-workout-tracker?retryWrites=true&w=majority"

# Any long random string. Changing it invalidates existing login tokens.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=3000

# ─── AI Coach providers (optional) ──────────────────────────────────────────
# Add at least one, or the coach falls back to its built-in offline answers.
# The app defaults to Gemini Flash, so GEMINI_API_KEY is the most useful one.
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""

# ─── Password reset email (optional) ────────────────────────────────────────
# Without this the reset code is returned in the API response instead of emailed.
RESEND_API_KEY=""
